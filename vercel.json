{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/updates.html", "has": [{ "type": "query", "key": "id", "value": "(?<id>.+)" }], "destination": "/notice/:id", "permanent": true },
    { "source": "/updates.html", "has": [{ "type": "query", "key": "tag", "value": "(?<tag>.+)" }], "destination": "/updates?type=:tag", "permanent": true },
    { "source": "/updates.html", "destination": "/updates", "permanent": true },
    { "source": "/books.html", "destination": "/#/books", "permanent": true },
    { "source": "/syllabus.html", "destination": "/#/syllabus", "permanent": true }
  ]
}
